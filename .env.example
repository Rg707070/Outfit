# Supabase — client-safe (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Weather widget (optional)
NEXT_PUBLIC_WEATHER_API_KEY=

# Server-only secret. Used ONLY by scripts/ (catalog ingestion). It bypasses RLS,
# so NEVER prefix with NEXT_PUBLIC_ and never import it into the app bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: set to "true" to compute semantic embeddings during ingestion via the
# `embed` Edge Function. Left off by default (lexical FTS + trigram search).
ENABLE_EMBEDDINGS=false
